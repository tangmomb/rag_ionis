# =========================
# ENVIRONMENT
# =========================
RAG_IONIS_ENV=local
APP_DOMAIN=localhost

# =========================
# DATABASE
# =========================
POSTGRES_DB=rag_ionis
POSTGRES_USER=rag_ionis
# Utiliser des valeurs aleatoires URL-safe, sans @, : ou /.
POSTGRES_PASSWORD=rag_ionis_dev_password
POSTGRES_PORT=5432
ANALYTICS_DATABASE_PASSWORD=rag_ionis_analytics_dev_password
DATABASE_URL=postgresql://rag_ionis:rag_ionis_dev_password@localhost:5432/rag_ionis
ANALYTICS_DATABASE_URL=postgresql://rag_ionis_analytics:rag_ionis_analytics_dev_password@localhost:5432/rag_ionis
ANALYTICS_MAX_TOTAL_COST=100000

# =========================
# OBSERVABILITY
# =========================
PHOENIX_ENABLED=true
PHOENIX_PORT=6006
PHOENIX_GRPC_PORT=4317
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=rag-ionis
RAG_LLM_REQUEST_TIMEOUT_SECONDS=300
RAG_LLM_MAX_RETRIES=

# =========================
# PIPELINE
# =========================
# local : tout sur ce poste ; modal : taches GPU sur Modal (deploy/MODAL.md).
PIPELINE_EXECUTION_BACKEND=local

# =========================
# API KEYS
# =========================
YOUTUBE_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=
GOOGLE_API_KEY=
COHERE_API_KEY=
HUGGINGFACE_TOKEN=
OPENAI_SERVICE_TIER=fast

# =========================
# STORAGE
# =========================
S3_BUCKET_NAME=rag-ionis
S3_REGION=fr-par
S3_ENDPOINT_URL=https://s3.fr-par.scw.cloud
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
