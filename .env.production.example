# =========================
# ENVIRONMENT
# =========================
RAG_IONIS_ENV=production
APP_DOMAIN=rag.example.fr

# Images de production immuables publiees par la CI.
CONTAINER_REGISTRY=rg.fr-par.scw.cloud/NAMESPACE
API_IMAGE_TAG=COMMIT_SHA
UPDATER_IMAGE_TAG=COMMIT_SHA

# =========================
# DATABASE
# =========================
POSTGRES_DB=rag_ionis
POSTGRES_USER=rag_ionis
# Utiliser des valeurs aleatoires URL-safe, sans @, : ou /.
POSTGRES_PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD
POSTGRES_PORT=5432
ANALYTICS_DATABASE_PASSWORD=CHANGE_ME_WITH_ANOTHER_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql://rag_ionis:CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD@localhost:5432/rag_ionis
ANALYTICS_DATABASE_URL=postgresql://rag_ionis_analytics:CHANGE_ME_WITH_ANOTHER_LONG_RANDOM_PASSWORD@localhost:5432/rag_ionis
ANALYTICS_MAX_TOTAL_COST=100000

# =========================
# OBSERVABILITY
# =========================
PHOENIX_ENABLED=true
PHOENIX_PORT=6006
PHOENIX_GRPC_PORT=4317
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=rag-ionis
RAG_SHADOW_EVALUATION_ENABLED=false
RAG_SHADOW_EVALUATION_MODEL=
RAG_CORRECTION_LOOP_ENABLED=true
RAG_LLM_REQUEST_TIMEOUT_SECONDS=300
RAG_LLM_MAX_RETRIES=

# =========================
# PIPELINE
# =========================
PIPELINE_EXECUTION_BACKEND=scaleway

# =========================
# SCALEWAY
# =========================
SCW_SECRET_KEY=CHANGE_ME
SCW_DEFAULT_PROJECT_ID=CHANGE_ME
SCW_DEFAULT_ZONE=fr-par-2
# Identifiant de la VM GPU dediee, provisionnee une seule fois.
SCALEWAY_SERVER_ID=CHANGE_ME
SCALEWAY_INSTANCE_TYPE=L4-1-24G
SCALEWAY_POLL_SECONDS=10
SCALEWAY_JOB_TIMEOUT_SECONDS=21600
SCALEWAY_MAX_CONCURRENT_JOBS=1
SCALEWAY_S3_JOB_PREFIX=scaleway/jobs
SCALEWAY_STOP_AFTER_JOB=1
SCALEWAY_KEEP_JOB_ARTIFACTS=0

# =========================
# API KEYS
# =========================
YOUTUBE_API_KEY=CHANGE_ME
OPENAI_API_KEY=CHANGE_ME
MISTRAL_API_KEY=CHANGE_ME
GOOGLE_API_KEY=CHANGE_ME
COHERE_API_KEY=CHANGE_ME
HUGGINGFACE_TOKEN=CHANGE_ME
OPENAI_SERVICE_TIER=fast

# =========================
# STORAGE
# =========================
S3_BUCKET_NAME=CHANGE_ME
S3_REGION=eu-west-3
# Facultatif pour Object Storage Scaleway: https://s3.fr-par.scw.cloud
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
