# Domaine dont l'enregistrement DNS A/AAAA pointe vers le VPS Scaleway.
APP_DOMAIN=rag.example.fr

# Protection temporaire de toute l'application par HTTP Basic Auth.
APP_BASIC_AUTH_USER=admin
# Generer avec : docker run --rm caddy:2-alpine caddy hash-password --plaintext 'mot-de-passe'
# Conserver les apostrophes pour que les signes $ du hash restent litteraux.
APP_BASIC_AUTH_HASH='$2a$14$REPLACE_WITH_A_REAL_CADDY_PASSWORD_HASH'

POSTGRES_DB=rag_ionis
POSTGRES_USER=rag_ionis
# Utiliser des valeurs aleatoires URL-safe, sans @, : ou /.
POSTGRES_PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD
ANALYTICS_DATABASE_PASSWORD=CHANGE_ME_WITH_ANOTHER_LONG_RANDOM_PASSWORD
ANALYTICS_MAX_TOTAL_COST=100000

MISTRAL_API_KEY=CHANGE_ME
OPENAI_API_KEY=CHANGE_ME
COHERE_API_KEY=CHANGE_ME
OPENAI_SERVICE_TIER=auto

PHOENIX_ENABLED=false
PHOENIX_PROJECT_NAME=rag-ionis
