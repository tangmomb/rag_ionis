# syntax=docker/dockerfile:1.7

FROM ghcr.io/astral-sh/uv:0.13.0 AS uv

FROM python:3.12.14-slim-trixie

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_PYTHON_DOWNLOADS=never \
    UV_LINK_MODE=copy \
    PATH=/opt/venv/bin:$PATH

WORKDIR /app

RUN addgroup --system app && adduser --system --ingroup app app

COPY --from=uv /uv /usr/local/bin/uv
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-project --no-default-groups --group api

COPY --chown=app:app interface ./interface

USER app

EXPOSE 8006

CMD ["python", "-m", "uvicorn", "interface.app:app", "--host", "0.0.0.0", "--port", "8006", "--workers", "2", "--proxy-headers", "--forwarded-allow-ips=*"]
