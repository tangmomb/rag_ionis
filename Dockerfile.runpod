FROM nvidia/cuda:12.6.3-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    RUNPOD_WORKER=1 \
    RUNPOD_ENFORCE_GPU=1 \
    RUNPOD_REQUIRED_GPU_NAME=4090 \
    RUNPOD_MIN_GPU_MEMORY_GB=20 \
    PIPELINE_EXECUTION_BACKEND=local \
    CUDA_MODULE_LOADING=LAZY \
    PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True \
    TOKENIZERS_PARALLELISM=true \
    XDG_CACHE_HOME=/runpod-volume/models/cache \
    TORCH_HOME=/runpod-volume/models/torch \
    HF_HOME=/runpod-volume/models/huggingface \
    PADDLE_HOME=/runpod-volume/models/paddle \
    PADDLE_PDX_CACHE_HOME=/runpod-volume/models/paddlex \
    WHISPERX_DEVICE=cuda \
    WHISPERX_COMPUTE_TYPE=float16 \
    WHISPERX_STRICT_CUDA=1 \
    WHISPERX_BATCH_SIZE=16 \
    WHISPERX_DIARIZATION_DEVICE=cuda \
    WHISPERX_DIARIZATION_CACHE_DIR=/runpod-volume/models/huggingface \
    WHISPERX_KEEP_MODEL=1 \
    FRAME_CLASSIFICATION_BATCH_SIZE=64 \
    FRAME_CLASSIFICATION_DTYPE=float16 \
    FRAME_CLASSIFICATION_KEEP_MODEL=1 \
    PADDLEOCR_BATCH_SIZE=32

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-pip ffmpeg nodejs ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt requirements-runpod.txt ./
RUN python3 -m pip install --upgrade pip \
    && python3 -m pip install --requirement requirements-runpod.txt

COPY pipeline ./pipeline
COPY models/frame_filter_2026-07-02_21-30-31.joblib ./models/frame_filter_2026-07-02_21-30-31.joblib

CMD ["python3", "-u", "-m", "pipeline.workers.runpod_ingestion"]
