# syntax=docker/dockerfile:1.7

ARG CUDA_BASE=nvidia/cuda:12.6.3-cudnn-runtime-ubuntu22.04
ARG NODE_BASE=node:22.18.0-bullseye-slim

# yt-dlp 2026 exige Node 22 ou plus pour les challenges JavaScript YouTube.
# La variante Bullseye reste compatible avec la glibc d'Ubuntu 22.04.
FROM ${NODE_BASE} AS node-runtime

# Paddle est assemble dans une etape jetable. Ses quatre plus gros binaires sont
# copies separement dans l'image finale afin que chaque blob reste publiable meme
# derriere un proxy qui coupe les uploads longs.
FROM ${CUDA_BASE} AS paddle-builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-pip ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-paddle-bootstrap.txt /tmp/requirements-paddle-bootstrap.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    python3 -m pip install --upgrade pip \
    && python3 -m pip install --no-deps --requirement /tmp/requirements-paddle-bootstrap.txt
RUN mkdir -p /paddle-parts \
    && mv /usr/local/lib/python3.10/dist-packages/paddle/base/libpaddle.so /paddle-parts/libpaddle.so \
    && mv /usr/local/lib/python3.10/dist-packages/paddle/libs/libflashattn.so /paddle-parts/libflashattn.so \
    && mv /usr/local/lib/python3.10/dist-packages/paddle/libs/libphi_core.so /paddle-parts/libphi_core.so \
    && mv /usr/local/lib/python3.10/dist-packages/paddle/libs/libphi_gpu.so /paddle-parts/libphi_gpu.so

FROM ${CUDA_BASE}

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DEFAULT_TIMEOUT=300 \
    PIP_RETRIES=10 \
    SCALEWAY_WORKER=1 \
    SCALEWAY_ENFORCE_GPU=1 \
    SCALEWAY_REQUIRED_GPU_NAME=L4 \
    SCALEWAY_MIN_GPU_MEMORY_GB=22 \
    PIPELINE_EXECUTION_BACKEND=local \
    CUDA_MODULE_LOADING=LAZY \
    PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True \
    TOKENIZERS_PARALLELISM=true \
    XDG_CACHE_HOME=/models/cache \
    PIP_CACHE_DIR=/root/.cache/pip \
    TORCH_HOME=/models/torch \
    HF_HOME=/models/huggingface \
    PADDLE_HOME=/models/paddle \
    PADDLE_PDX_CACHE_HOME=/models/paddlex \
    WHISPERX_DEVICE=cuda \
    WHISPERX_COMPUTE_TYPE=float16 \
    WHISPERX_STRICT_CUDA=1 \
    WHISPERX_BATCH_SIZE=8 \
    WHISPERX_DIARIZATION_DEVICE=cuda \
    WHISPERX_DIARIZATION_CACHE_DIR=/models/huggingface \
    WHISPERX_KEEP_MODEL=1 \
    FRAME_CLASSIFICATION_BATCH_SIZE=32 \
    FRAME_CLASSIFICATION_DTYPE=float16 \
    FRAME_CLASSIFICATION_KEEP_MODEL=1 \
    PADDLEOCR_BATCH_SIZE=16

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-pip ffmpeg ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=node-runtime /usr/local/bin/node /usr/local/bin/node
RUN node --version \
    && test "$(node --version | cut -d. -f1)" = "v22"

RUN --mount=type=cache,target=/root/.cache/pip python3 -m pip install --upgrade pip

# Les bibliotheques CUDA de Torch sont volontairement reparties en couches :
# cela evite un unique blob de plus de 10 Go et rend les pushes reprenables.
# Torch 2.8 et Paddle 3.2 declarent trois versions NVIDIA incompatibles
# (cuDNN, cuSPARSELt et NCCL). Les versions Torch ci-dessous sont conservees :
# le smoke test de l'image execute bien Torch puis Paddle sur CUDA 12.6.
RUN --mount=type=cache,target=/root/.cache/pip python3 -m pip install --no-deps \
    nvidia-cudnn-cu12==9.10.2.21
RUN --mount=type=cache,target=/root/.cache/pip python3 -m pip install --no-deps \
    nvidia-cublas-cu12==12.6.4.1 nvidia-cufft-cu12==11.3.0.4
RUN --mount=type=cache,target=/root/.cache/pip python3 -m pip install --no-deps \
    nvidia-cusolver-cu12==11.7.1.2 nvidia-cusparse-cu12==12.5.4.2
RUN --mount=type=cache,target=/root/.cache/pip python3 -m pip install --no-deps \
    nvidia-cusparselt-cu12==0.7.1 nvidia-nccl-cu12==2.27.3
RUN --mount=type=cache,target=/root/.cache/pip python3 -m pip install --no-deps \
    nvidia-cuda-cupti-cu12==12.6.80 nvidia-cuda-nvrtc-cu12==12.6.77 \
    nvidia-cuda-runtime-cu12==12.6.77 nvidia-cufile-cu12==1.11.1.6 \
    nvidia-curand-cu12==10.3.7.77 nvidia-nvjitlink-cu12==12.6.85 \
    nvidia-nvtx-cu12==12.6.77 nvidia-cuda-cccl-cu12==12.6.77 opt-einsum==3.3.0
RUN --mount=type=cache,target=/root/.cache/pip python3 -m pip install --no-deps \
    --index-url https://download.pytorch.org/whl/cu126/ \
    torch==2.8.0+cu126 torchvision==0.23.0+cu126 torchaudio==2.8.0+cu126

# Le reste est separe entre dependances generales, audio/Whisper et OCR.
COPY requirements-gpu.txt ./
RUN --mount=type=cache,target=/root/.cache/pip \
    sed -e '/^--extra-index-url /d' \
        -e '/^paddlepaddle-gpu==/d' -e '/^paddleocr==/d' \
        -e '/^torch==/d' -e '/^torchvision==/d' -e '/^torchaudio==/d' \
        -e '/^openai-whisper==/d' -e '/^whisperx==/d' -e '/^transformers/d' \
        requirements-gpu.txt > /tmp/requirements-core.txt \
    && python3 -m pip install --requirement /tmp/requirements-core.txt
RUN --mount=type=cache,target=/root/.cache/pip python3 -m pip install \
    pyannote-database==6.1.1 \
    openai-whisper==20250625 whisperx==3.8.6 transformers==4.57.6
RUN --mount=type=cache,target=/root/.cache/pip python3 -m pip install \
    paddleocr==3.7.0

# Copie Paddle GPU depuis l'etape jetable, en blobs de taille bornee.
COPY --from=paddle-builder /usr/local/lib/python3.10/dist-packages/paddle /usr/local/lib/python3.10/dist-packages/paddle
COPY --from=paddle-builder /usr/local/lib/python3.10/dist-packages/paddlepaddle_gpu-3.2.0.dist-info /usr/local/lib/python3.10/dist-packages/paddlepaddle_gpu-3.2.0.dist-info
COPY --from=paddle-builder /paddle-parts/libpaddle.so /usr/local/lib/python3.10/dist-packages/paddle/base/libpaddle.so
COPY --from=paddle-builder /paddle-parts/libflashattn.so /usr/local/lib/python3.10/dist-packages/paddle/libs/libflashattn.so
COPY --from=paddle-builder /paddle-parts/libphi_core.so /usr/local/lib/python3.10/dist-packages/paddle/libs/libphi_core.so
COPY --from=paddle-builder /paddle-parts/libphi_gpu.so /usr/local/lib/python3.10/dist-packages/paddle/libs/libphi_gpu.so

# yt-dlp evolue plus souvent que les dependances GPU. Le garder dans une
# couche tardive evite de reinstaller Whisper et PaddleOCR a chaque mise a jour.
COPY requirements-ytdlp.txt ./
RUN --mount=type=cache,target=/root/.cache/pip python3 -m pip install \
    --requirement requirements-ytdlp.txt

COPY pipeline ./pipeline
COPY models/frame_filter_2026-07-02_21-30-31.joblib ./models/frame_filter_2026-07-02_21-30-31.joblib

CMD ["python3", "-u", "-m", "pipeline.workers.scaleway_ingestion", "--poll"]
