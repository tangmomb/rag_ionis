# Relais du tunnel YouTube vers les conteneurs Docker du VPS.
#
# Le service yt-tunnel (projet agent_mots_cles) ouvre un proxy SOCKS sur
# 127.0.0.1:1080, joignable seulement depuis l'hote. L'updater de rag_ionis
# tourne dans Docker : ce relais expose le meme proxy sur la passerelle Docker
# (172.17.0.1, alias host.docker.internal), jamais sur l'IP publique.
#
# Installation (root) :
#   apt-get install -y socat
#   install -m 0644 deploy/rag-ionis-yt-proxy.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now rag-ionis-yt-proxy
#
# Verification depuis un conteneur :
#   docker run --rm --add-host host.docker.internal:host-gateway curlimages/curl \
#     -sS -o /dev/null -w '%{http_code}\n' -x socks5h://host.docker.internal:1080 https://www.youtube.com

[Unit]
Description=RAG Ionis YouTube proxy relay for Docker containers
Requires=yt-tunnel.service
After=yt-tunnel.service docker.service
Wants=docker.service

[Service]
Type=simple
DynamicUser=yes
ExecStart=/usr/bin/socat TCP-LISTEN:1080,bind=172.17.0.1,reuseaddr,fork TCP:127.0.0.1:1080
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
