# Configuration du worker dans la VM GPU dediee.
SCALEWAY_CONTAINER_IMAGE=rg.fr-par.scw.cloud/NAMESPACE/rag-ionis-scaleway:VERSION
SCALEWAY_WORKER_PULL_IMAGE=0
SCALEWAY_WORKER_POLL_SECONDS=5
SCALEWAY_WORKER_IDLE_SECONDS=30
SCALEWAY_WORKER=1
PIPELINE_EXECUTION_BACKEND=local

S3_BUCKET_NAME=CHANGE_ME
S3_REGION=eu-west-3
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
SCALEWAY_S3_JOB_PREFIX=scaleway/jobs

YOUTUBE_API_KEY=CHANGE_ME
OPENAI_API_KEY=CHANGE_ME
MISTRAL_API_KEY=CHANGE_ME
GOOGLE_API_KEY=CHANGE_ME
COHERE_API_KEY=CHANGE_ME
HUGGINGFACE_TOKEN=CHANGE_ME
WHISPERX_MODEL=large-v3
WHISPERX_LANGUAGE=fr
WHISPERX_DEVICE=cuda
WHISPERX_COMPUTE_TYPE=float16
WHISPERX_STRICT_CUDA=1
WHISPERX_DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
WHISPERX_DIARIZATION_DEVICE=cuda
WHISPERX_DIARIZATION_CACHE_DIR=/models/huggingface
SCALEWAY_ENFORCE_GPU=1
SCALEWAY_REQUIRED_GPU_NAME=L40S
SCALEWAY_MIN_GPU_MEMORY_GB=44
