[Unit]
Description=Restore the latest RAG IONIS backup into a throwaway database weekly

[Timer]
# Après la sauvegarde nocturne, décalée de 15 minutes au plus.
OnCalendar=Mon *-*-* 01:15:00 Europe/Paris
Persistent=true
AccuracySec=1min
Unit=rag-ionis-monitor@restore.service

[Install]
WantedBy=timers.target
