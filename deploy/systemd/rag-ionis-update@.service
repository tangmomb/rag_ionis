[Unit]
Description=RAG IONIS scheduled %i update
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
ConditionPathExists=/srv/rag_ionis/.env.production
# Un échec envoie une alerte Telegram (rag-ionis-notify-failure.sh).
OnFailure=rag-ionis-notify-failure@%n.service

[Service]
Type=oneshot
WorkingDirectory=/srv/rag_ionis
# Pings healthchecks.io : une tâche qui ne tourne plus déclenche une alerte.
# L'échec est signalé par rag-ionis-notify-failure.sh.
ExecStartPre=-/usr/bin/bash /usr/local/bin/rag-ionis-healthcheck.sh %n start
ExecStart=/usr/bin/bash /srv/rag_ionis/deploy/run-scheduled-update.sh %i
ExecStartPost=-/usr/bin/bash /usr/local/bin/rag-ionis-healthcheck.sh %n success
TimeoutStartSec=infinity
Nice=10

[Install]
WantedBy=multi-user.target
